{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Branch",
  "version": "0.1.0",
  "identifier": "com.drifted.branch",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Branch",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://localhost:* http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Drifted",
    "copyright": "Copyright (c) 2026 Drifted",
    "category": "Utility",
    "shortDescription": "Free Gorilla Tag mod finder",
    "longDescription": "Branch is a free app for finding and downloading Gorilla Tag mods. It is an independent project and is not affiliated with Another Axiom.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
