# settings for the branch server (server/). copy this to server/.env for local
# development, or add each one as a variable in railway. never commit real values.

# postgres connection. on railway use the reference ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://branch:branch@localhost:5432/branch

# railway sets PORT for you
PORT=8080

# a long random string (at least 32 characters). used to hash ip addresses.
SERVER_SECRET=replace-with-a-long-random-string-at-least-32-characters

# set to false only for local http testing
COOKIE_SECURE=true

# where uploads go: "s3" (a bucket) or "local" (a folder, only for development
# or a railway volume)
STORAGE_DRIVER=s3
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# LOCAL_STORAGE_DIR=./data

# creates the first admin, only when there are no admins yet.
# remove both right after the first successful start.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

RUST_LOG=info
